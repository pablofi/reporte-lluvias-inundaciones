APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=America/Mexico_City
DATABASE_URL=sqlite:///data/database/app.db

OPENAI_API_KEY=
OPENAI_MODEL=

SOURCE_CHECK_INTERVAL_MINUTES=15

SOURCE_MONITOR_ENABLED=true
SOURCE_STORAGE_DIR=data/sources
SOURCE_HTTP_TIMEOUT_SECONDS=20
SOURCE_HTTP_RETRIES=2
# Umbrales operativos provisionales desde el último éxito, no validez meteorológica.
SOURCE_MAX_AGE_HOURS='{"smn_pronostico_general":24,"smn_potencial_tormentas":24,"nhc_atlantic_twd":24,"nhc_eastern_pacific_twd":24}'
